                        }
                    },
                    {
                        id: "ind_3_5",
                        name: "Частота вияву вмінь / Очікуваний результат: Стабільність перенесення знань",
                        criteriaName: "Конкретний критерій: Систематичність застосування законів фізики",
                        levels: {
                            "1-3": [
                                "1 - уміння практично не виявляє;",
                                "2 - виявляє епізодично;",
                                "3 - застосовує лише у знайомій ситуації з допомогою"
                            ],
                            "4-6": [
                                "4 - застосовує у простій ситуації;",
                                "5 - у типових завданнях;",
                                "6 - стабільно за відомим алгоритмом"
                            ],
                            "7-9": [
                                "7 - стабільно застосовує;",
                                "8 - переносить знання на змінені ситуації;",
                                "9 - застосовує у різних ситуаціях"
                            ],
                            "10-12": [
                                "10 - переносить знання на складні ситуації;",
                                "11 - застосовує у нестандартних ситуаціях;",
                                "12 - системно переносить знання на нові умови"
