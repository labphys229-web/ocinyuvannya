                    }
                ]
            }
        };

        // Application State
        let appState = {
            students: [
                { id: "s1", name: "Коваленко Іван" },
                { id: "s2", name: "Мельник Софія" },
                { id: "s3", name: "Шевченко Олександр" }
            ],
            assessments: {} // studentId -> { grId_indId: score }
        };

        // Load data from localStorage if available
        function loadData() {
            const saved = localStorage.getItem('physics_assessment_app_data');
            if (saved) {
                try {
                    appState = JSON.parse(saved);
                } catch(e) {
                    console.error("Помилка завантаження даних", e);
                }
            }
        }

        // Save data to localStorage
        function saveData() {
            localStorage.setItem('physics_assessment_app_data', JSON.stringify(appState));
        }

        // Tab Switching
        function switchTab(tabName) {
            const assessmentTab = document.getElementById('tab-assessment');
            const registryTab = document.getElementById('tab-registry');
            const btnAssess = document.getElementById('btn-tab-assessment');
            const btnRegistry = document.getElementById('btn-tab-registry');

            if (tabName === 'assessment') {
                assessmentTab.classList.remove('hidden');
                registryTab.classList.add('hidden');
                btnAssess.className = "px-4 py-2 bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-800";
                btnRegistry.className = "px-4 py-2 bg-indigo-500 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-600";
            } else {
                assessmentTab.classList.add('hidden');
                registryTab.classList.remove('hidden');
                btnRegistry.className = "px-4 py-2 bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-800";
                btnAssess.className = "px-4 py-2 bg-indigo-500 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-600";
                renderRegistryTable();
            }
        }

        // Initialization
        window.onload = function() {
            loadData();
            updateStudentDropdown();
        };

        function updateStudentDropdown() {
            const select = document.getElementById('select-student');
            const currentVal = select.value;
            select.innerHTML = '<option value="">-- Оберіть учня --</option>';
            appState.students.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = s.name;
                select.appendChild(opt);
            });
            select.value = currentVal;
        }

        // Step 1: GR Change Handler
        function onGrChange() {
            const grKey = document.getElementById('select-gr').value;
            const indSelect = document.getElementById('select-indicator');
            
            indSelect.innerHTML = '<option value="">-- Оберіть інтегрований показник --</option>';
            
            if (!grKey) {
                indSelect.disabled = true;
                hideCriteriaMatrix();
                return;
            }

            indSelect.disabled = false;
            const gr = rubricData[grKey];
            gr.indicators.forEach((ind, index) => {
                const opt = document.createElement('option');
                opt.value = index;
                opt.textContent = `${index + 1}. ${ind.name}`;
                indSelect.appendChild(opt);
            });

            hideCriteriaMatrix();
        }

        // Step 2: Indicator Change Handler
        function onIndicatorChange() {
            checkAndRenderMatrix();
        }

        // Step 3: Student Change Handler
        function onStudentChange() {
            checkAndRenderMatrix();
        }

        function checkAndRenderMatrix() {
            const grKey = document.getElementById('select-gr').value;
            const indIndex = document.getElementById('select-indicator').value;
            const studentId = document.getElementById('select-student').value;

            if (grKey !== "" && indIndex !== "" && studentId !== "") {
                renderCriteriaMatrix(grKey, parseInt(indIndex), studentId);
            } else {
                hideCriteriaMatrix();
            }
        }

        function hideCriteriaMatrix() {
            document.getElementById('criteria-container').classList.add('hidden');
            document.getElementById('empty-state').classList.remove('hidden');
        }

        // Render Matrix Table for Scoring
        function renderCriteriaMatrix(grKey, indIndex, studentId) {
            const gr = rubricData[grKey];
            const indicator = gr.indicators[indIndex];
            
            document.getElementById('current-eval-title').textContent = gr.title;
            document.getElementById('current-eval-subtitle').textContent = indicator.name;

            const rowsContainer = document.getElementById('matrix-rows');
            rowsContainer.innerHTML = '';

            // Get existing score for this student, gr, indicator
            const studentAssessments = appState.assessments[studentId] || {};
            const key = `${grKey}_${indicator.id}`;
            const currentSelectedScore = studentAssessments[key] || 0;

            // We create 4 column blocks for score ranges: 1-3, 4-6, 7-9, 10-12
            const scoreRanges = [
                { range: "1-3", label: "1-3 бали (Початковий)", color: "border-rose-200 bg-rose-50/50" },
                { range: "4-6", label: "4-6 балів (Середній)", color: "border-amber-200 bg-amber-50/50" },
                { range: "7-9", label: "7-9 балів (Достатній)", color: "border-blue-200 bg-blue-50/50" },
                { range: "10-12", label: "10-12 балів (Високий)", color: "border-emerald-200 bg-emerald-50/50" }
            ];

            const gridDiv = document.createElement('div');
            gridDiv.className = "grid grid-cols-1 md:grid-cols-4 gap-4";

            scoreRanges.forEach(sr => {
                const colDiv = document.createElement('div');
                colDiv.className = `p-4 rounded-xl border ${sr.color} flex flex-col justify-between`;

                let innerHtml = `<h4 class="font-bold text-slate-700 text-sm mb-3 pb-2 border-b border-slate-200">${sr.label}</h4>`;
                innerHtml += `<div class="space-y-2 mb-4">`;

                const descriptions = indicator.levels[sr.range] || [];
                descriptions.forEach(desc => {
                    innerHtml += `
                        <label class="flex items-start gap-2 text-xs text-slate-600 bg-white p-2.5 rounded-lg border border-slate-200 cursor-pointer hover:border-indigo-300 transition">
                            <input type="radio" name="criteria_choice" value="${sr.range}" data-desc="${desc}" class="mt-0.5 text-indigo-600 focus:ring-indigo-500" ${isDescriptionSelected(currentSelectedScore, sr.range, desc) ? 'checked' : ''} onchange="updateCalculatedScore()">
                            <span>${desc}</span>
                        </label>
                    `;
                });

                innerHtml += `</div>`;
                colDiv.innerHTML = innerHtml;
                gridDiv.appendChild(colDiv);
            });

            rowsContainer.appendChild(gridDiv);

            document.getElementById('criteria-container').classList.remove('hidden');
            document.getElementById('empty-state').classList.add('hidden');
            updateCalculatedScore();
        }

        function isDescriptionSelected(savedScore, range, desc) {
            if (!savedScore) return false;
            const [min, max] = range.split('-').map(Number);
            return savedScore >= min && savedScore <= max;
        }

        function updateCalculatedScore() {
            const radios = document.querySelectorAll('input[name="criteria_choice"]:checked');
            const scoreDisplay = document.getElementById('calculated-score');
            if (radios.length > 0) {
                const range = radios[0].value;
                const [min, max] = range.split('-').map(Number);
                const midScore = Math.round((min + max) / 2);
                scoreDisplay.textContent = `${midScore} б.`;
            } else {
                scoreDisplay.textContent = "--";
            }
        }

        function saveStudentAssessment() {
            const studentId = document.getElementById('select-student').value;
            const grKey = document.getElementById('select-gr').value;
            const indIndex = document.getElementById('select-indicator').value;
            const radios = document.querySelectorAll('input[name="criteria_choice"]:checked');

            if (!studentId || grKey === "" || indIndex === "") {
                showNotification("Помилка", "Оберіть учня, ГР та показник.", "❌");
                return;
            }

            if (radios.length === 0) {
                showNotification("Увага", "Будь ласка, оберіть відповідний рівень досягнень у критеріях.", "⚠️");
                return;
            }

            const range = radios[0].value;
            const [min, max] = range.split('-').map(Number);
            const score = Math.round((min + max) / 2);

            const gr = rubricData[grKey];
            const indicator = gr.indicators[indIndex];
            const key = `${grKey}_${indicator.id}`;

            if (!appState.assessments[studentId]) {
                appState.assessments[studentId] = {};
            }
            appState.assessments[studentId][key] = score;

            saveData();
            showNotification("Збережено!", "Оцінку успішно збережено в системі.", "✅");
        }

        // Modal Management for Students
        function openAddStudentModal() {
            document.getElementById('input-student-name').value = '';
            document.getElementById('modal-add-student').classList.remove('hidden');
        }

        function closeAddStudentModal() {
            document.getElementById('modal-add-student').classList.add('hidden');
        }

        function addStudent() {
            const nameInput = document.getElementById('input-student-name');
            const name = nameInput.value.trim();
            if (!name) {
                showNotification("Помилка", "Введіть прізвище та ім'я учня.", "❌");
                return;
            }

            const newId = 's_' + Date.now();
            appState.students.push({ id: newId, name: name });
            saveData();
            updateStudentDropdown();
            closeAddStudentModal();
            showNotification("Успіх", `Учня ${name} додано до журналу.`, "✅");
        }

        // Notifications
        function showNotification(title, message, icon) {
            document.getElementById('notification-title').textContent = title;
            document.getElementById('notification-message').textContent = message;
            document.getElementById('notification-icon').textContent = icon;
            document.getElementById('modal-notification').classList.remove('hidden');
        }

        function closeNotification() {
            document.getElementById('modal-notification').classList.add('hidden');
        }

        // Registry Table rendering
        function renderRegistryTable() {
            const tbody = document.getElementById('registry-table-body');
            tbody.innerHTML = '';

            if (appState.students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">Список учнів порожній. Додайте учнів через вкладку оцінювання або журнал.</td></tr>`;
                return;
            }

            appState.students.forEach(student => {
                const studentAssessments = appState.assessments[student.id] || {};
                
                let gr1Scores = [], gr2Scores = [], gr3Scores = [];
                
                Object.keys(studentAssessments).forEach(k => {
                    if (k.startsWith('gr1_')) gr1Scores.push(studentAssessments[k]);
                    if (k.startsWith('gr2_')) gr2Scores.push(studentAssessments[k]);
                    if (k.startsWith('gr3_')) gr3Scores.push(studentAssessments[k]);
                });

                const avgGr1 = gr1Scores.length ? (gr1Scores.reduce((a,b)=>a+b,0) / gr1Scores.length).toFixed(1) : '-';
                const avgGr2 = gr2Scores.length ? (gr2Scores.reduce((a,b)=>a+b,0) / gr2Scores.length).toFixed(1) : '-';
                const avgGr3 = gr3Scores.length ? (gr3Scores.reduce((a,b)=>a+b,0) / gr3Scores.length).toFixed(1) : '-';

                const tr = document.createElement('tr');
                tr.className = "border-b hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-3 font-medium text-slate-800">${student.name}</td>
                    <td class="p-3 text-indigo-600 font-semibold">${avgGr1}</td>
                    <td class="p-3 text-indigo-600 font-semibold">${avgGr2}</td>
                    <td class="p-3 text-indigo-600 font-semibold">${avgGr3}</td>
                    <td class="p-3 text-right">
                        <button onclick="deleteStudent('${student.id}')" class="text-rose-500 hover:text-rose-700 text-xs px-2.5 py-1 bg-rose-50 rounded border border-rose-200">Видалити</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function deleteStudent(studentId) {
            if (confirm("Ви дійсно хочете видалити цього учня та всі його оцінки?")) {
                appState.students = appState.students.filter(s => s.id !== studentId);
                delete appState.assessments[studentId];
                saveData();
                updateStudentDropdown();
                renderRegistryTable();
            }
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "physics_assessment_data.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }
    </script>
</body>
</html>
