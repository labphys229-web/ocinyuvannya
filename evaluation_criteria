<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Оцінювання учнів з фізики (НУШ)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <header class="bg-indigo-600 text-white shadow-md py-4 px-6 mb-6">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold flex items-center gap-2">
                    ⚡ Оцінювання з фізики (НУШ)
                </h1>
                <p class="text-indigo-200 text-sm">Інтерактивна система оцінювання за групами результатів</p>
            </div>
            <div class="flex gap-2">
                <button onclick="switchTab('assessment')" id="btn-tab-assessment" class="px-4 py-2 bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-800">
                    Оцінювання
                </button>
                <button onclick="switchTab('registry')" id="btn-tab-registry" class="px-4 py-2 bg-indigo-500 text-white font-medium rounded-lg shadow-sm transition hover:bg-indigo-600">
                    Журнал учнів
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 w-full flex-grow mb-12">

        <!-- ASSESSMENT TAB -->
        <div id="tab-assessment" class="space-y-6">
            
            <!-- Step Selection Card -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- Step 1: GR Selection -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Крок 1: Група результатів (ГР)</label>
                    <select id="select-gr" onchange="onGrChange()" class="w-full p-3 bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <option value="">-- Оберіть ГР --</option>
                        <option value="gr1">ГР1: Досліджує фізичні явища та процеси</option>
                        <option value="gr2">ГР2: Опрацювання інформації</option>
                        <option value="gr3">ГР3: Усвідомлює закономірності природи</option>
                    </select>
                </div>

                <!-- Step 2: Indicator Selection -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Крок 2: Інтегрований показник</label>
                    <select id="select-indicator" onchange="onIndicatorChange()" disabled class="w-full p-3 bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none disabled:bg-slate-100 disabled:text-slate-400">
                        <option value="">-- Спочатку оберіть ГР --</option>
                    </select>
                </div>

                <!-- Step 3: Student Selection -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Крок 3: Учень / Учениця</label>
                    <div class="flex gap-2">
                        <select id="select-student" onchange="onStudentChange()" class="w-full p-3 bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="">-- Оберіть учня --</option>
                        </select>
                        <button onclick="openAddStudentModal()" class="bg-indigo-50 text-indigo-600 p-3 rounded-lg border border-indigo-200 hover:bg-indigo-100 font-medium whitespace-nowrap" title="Додати нового учня">
                            + Додати
                        </button>
                    </div>
                </div>

            </div>

            <!-- Detailed Criteria Matrix Area -->
            <div id="criteria-container" class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 hidden">
                <div class="flex justify-between items-center mb-6 border-b pb-4">
                    <div>
                        <h2 id="current-eval-title" class="text-xl font-bold text-slate-800">Матриця оцінювання</h2>
                        <p id="current-eval-subtitle" class="text-sm text-slate-500">Оберіть відповідні рівні за критеріями для учня</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-right">
                            <span class="text-xs text-slate-400 block">Розрахований бал:</span>
                            <span id="calculated-score" class="text-2xl font-extrabold text-indigo-600">--</span>
                        </div>
                        <button onclick="saveStudentAssessment()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-5 py-2.5 rounded-lg shadow-sm transition">
                            Зберегти оцінку
                        </button>
                    </div>
                </div>

                <div id="matrix-rows" class="space-y-6">
                    <!-- Dynamic criteria rows will be injected here -->
                </div>
            </div>

            <!-- Empty State -->
            <div id="empty-state" class="bg-white p-12 rounded-xl shadow-sm border border-slate-200 text-center">
                <div class="text-indigo-400 text-5xl mb-3">📋</div>
                <h3 class="text-lg font-semibold text-slate-700">Розпочніть оцінювання</h3>
                <p class="text-slate-500 text-sm max-w-md mx-auto mt-1">Виконайте кроки вище: оберіть групу результатів, показник та учня, щоб відкрити критеріальну матрицю.</p>
            </div>

        </div>

        <!-- REGISTRY TAB -->
        <div id="tab-registry" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">Журнал результатів учнів</h2>
                        <p class="text-sm text-slate-500">Зведені дані оцінювання за групами результатів та показниками</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="openAddStudentModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                            + Додати учня
                        </button>
                        <button onclick="exportData()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-lg transition border border-slate-300">
                            Експорт JSON
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 text-sm">
                                <th class="p-3 border-b">ПІБ Учня / Учениці</th>
                                <th class="p-3 border-b">ГР1 (Серреднє)</th>
                                <th class="p-3 border-b">ГР2 (Середнє)</th>
                                <th class="p-3 border-b">ГР3 (Середнє)</th>
                                <th class="p-3 border-b text-right">Дії</th>
                            </tr>
                        </thead>
                        <tbody id="registry-table-body">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Add Student Modal -->
    <div id="modal-add-student" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-800">Додати нового учня</h3>
            <div>
                <label class="block text-sm font-medium text-slate-600 mb-1">Прізвище та Ім'я учня</label>
                <input type="text" id="input-student-name" placeholder="напр. Шевченко Тарас" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button onclick="closeAddStudentModal()" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg font-medium">Скасувати</button>
                <button onclick="addStudent()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium">Додати</button>
            </div>
        </div>
    </div>

    <!-- Custom Notification Modal -->
    <div id="modal-notification" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center space-y-4">
            <div id="notification-icon" class="text-4xl">✅</div>
            <h4 id="notification-title" class="text-lg font-bold text-slate-800">Успішно</h4>
            <p id="notification-message" class="text-sm text-slate-600">Дані збережено.</p>
            <button onclick="closeNotification()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg">Зрозуміло</button>
        </div>
    </div>

